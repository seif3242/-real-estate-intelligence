# Application
APP_ENV=development
APP_NAME=real-estate-ai-backend
LOG_LEVEL=INFO

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=real_estate_ai
POSTGRES_USER=real_estate_ai
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://real_estate_ai:change-me@localhost:5432/real_estate_ai

# WhatsApp Collector (provider abstraction)
WHATSAPP_PROVIDER=whatsapp_web
WHATSAPP_SESSION_PATH=/data/whatsapp-session
WHATSAPP_SESSION_ENCRYPTION_KEY=change-me

# Claude API (not used until Milestone 2+, kept here for forward config only)
ANTHROPIC_API_KEY=
